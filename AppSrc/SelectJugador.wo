// C:\DataFlex Projects\FutbolApp\AppSrc\SelectJugador.wo
// Jugador
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Object oSelectJugador is a cWebView
    Set psCaption to "Jugadores"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to True
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To ojugador_DD
    Set Server  To ojugador_DD


    Object oList is a cWebList
        Set piColumnSpan to 0
        Set psCSSClass to "MobileList"
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set pbShowHeader to True
        Set piSortColumn to 0
        
        Set piOrdering to 1 
        Set pbAutoSearch to True
        
         WebRegisterPath ntNavigateForward oZoomJugador

        Object ojugadorNombre is a cWebColumn
            Entry_Item jugador.Nombre
            Set psCaption to "Nombre"
            Set piWidth to 745
        End_Object 

        Object ojugadorApellido is a cWebColumn
            Entry_Item jugador.Apellido
            Set psCaption to "Apellido"
            Set piWidth to 745
        End_Object 

        Object ojugadorNacionalidad is a cWebColumn
            Entry_Item jugador.Nacionalidad
            Set psCaption to "Nacionalidad"
            Set piWidth to 621
        End_Object 

        Object oequipoNombre is a cWebColumn
            Entry_Item equipo.Nombre
            Set psCaption to "Equipo"
            Set piWidth to 1491
        End_Object 

        Object oligaNombre is a cWebColumn
            Entry_Item liga.Nombre
            Set psCaption to "Liga"
            Set piWidth to 1243
        End_Object 

        Object oligaPais is a cWebColumn
            Entry_Item liga.Pais
            Set psCaption to "Pais"
            Set piWidth to 621
        End_Object 

        /*Object oligaEquipos is a cWebColumn
            //Entry_Item liga.Equipos
            Set psCaption to "liga.Equipos"
            Set piWidth to 124
        End_Object 

        Object oligaEquiposMax is a cWebColumn
            Entry_Item liga.EquiposMax
            Set psCaption to "liga.EquiposMax"
            Set piWidth to 124
        End_Object */

        Object oDetailButton is a cWebColumnButton
            Set psCaption to ""
            Set piWidth to 45
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

// ToDo: Fill in the from-main Zoom view object name for navigate forward
            WebRegisterPath ntNavigateForward oZoomJugador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure

        End_Object 

// ToDo: Fill in the from-parent child Select view object name for navigate forward
//        WebRegisterPath ntNavigateForward oSelectView

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
// ToDo: Fill in the from-parent child Select view object name for navigate forward
//Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
//                    Send NavigateForward of oSelectView Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
// ToDo: Fill in the from-parent child Select view object name for navigate forward
//Error DFERR_PROGRAM "NavigateForward to this from-parent child Select view not yet defined"
//                    Send NavigateForward of oSelectView Self

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move True to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

// ToDo: Fill in the from-main Zoom view object name for navigate forward
            WebRegisterPath ntNavigateForward oZoomJugador

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True
        
        Case Begin
            // --- MODALIDAD 1: SI ENTRAS DESDE EQUIPO (Solo Datos Esenciales) ---
            Case (NavigateData.eNavigateType = nfFromParent)
                WebSet psCaption to "Jugadores del Equipo"
                
                // OCULTAMOS las columnas que no queremos ver desde Equipo
                WebSet pbRender of oligaNombre   to False
                WebSet pbRender of oligaPais     to False
                WebSet pbRender of oequipoNombre to False
                
                // MOSTRAMOS solo Nombre, Apellido y Nacionalidad
                WebSet pbRender of ojugadorNombre to True
                WebSet pbRender of ojugadorApellido to True
                WebSet pbRender of ojugadorNacionalidad to True

                // Sincronización limpia de la base de datos por ID
                Send Clear of ojugador_DD
                Send Rebuild_Constraints of ojugador_DD
                Case Break

            // --- MODALIDAD 2: SI ENTRAS DESDE JUGADOR (Se ven TODOS los datos) ---
            Case (NavigateData.eNavigateType = nfFromMain)
                WebSet psCaption to "Listado General de Jugadores"
                
                // MOSTRAMOS ABSOLUTAMENTE TODAS LAS COLUMNAS
                WebSet pbRender of ojugadorNombre to True
                WebSet pbRender of ojugadorApellido to True
                WebSet pbRender of ojugadorNacionalidad to True
                WebSet pbRender of oligaNombre   to True
                WebSet pbRender of oligaPais     to True
                WebSet pbRender of oequipoNombre to True
                
                WebSet pbRender of oDetailButton to False
                
                Send Rebuild_Constraints of ojugador_DD
                Case Break
        Case End

        // OBLIGATORIO: Fuerza a la lista a redibujar las columnas en el navegador
        Send RefreshListFromDD of oList
        End_Procedure

       /* Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.

        Case End

    End_Procedure*/


End_Object 
