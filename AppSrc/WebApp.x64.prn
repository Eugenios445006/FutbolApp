38586>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38589>>>        WebSet pbRender of oNewButton to True
38590>>>        WebSet pbRender of oDetailButton to True
38591>>>        
38591>>>        Case Begin
38591>>>            // --- MODALIDAD 1: SI ENTRAS DESDE EQUIPO (Solo Datos Esenciales) ---
38591>>>            Case (NavigateData.eNavigateType = nfFromParent)
38593>>>                WebSet psCaption to "Jugadores del Equipo"
38594>>>                
38594>>>                // OCULTAMOS las columnas que no queremos ver desde Equipo
38594>>>                WebSet pbRender of oligaNombre   to False
38595>>>                WebSet pbRender of oligaPais     to False
38596>>>                WebSet pbRender of oequipoNombre to False
38597>>>                
38597>>>                // MOSTRAMOS solo Nombre, Apellido y Nacionalidad
38597>>>                WebSet pbRender of ojugadorNombre to True
38598>>>                WebSet pbRender of ojugadorApellido to True
38599>>>                WebSet pbRender of ojugadorNacionalidad to True
38600>>>
38600>>>                // Sincronización limpia de la base de datos por ID
38600>>>                Send Clear of ojugador_DD
38601>>>                Send Rebuild_Constraints of ojugador_DD
38602>>>                Case Break
38603>>>
38603>>>            // --- MODALIDAD 2: SI ENTRAS DESDE JUGADOR (Se ven TODOS los datos) ---
38603>>>            Case (NavigateData.eNavigateType = nfFromMain)
38606>>>                WebSet psCaption to "Listado General de Jugadores"
38607>>>                
38607>>>                // MOSTRAMOS ABSOLUTAMENTE TODAS LAS COLUMNAS
38607>>>                WebSet pbRender of ojugadorNombre to True
38608>>>                WebSet pbRender of ojugadorApellido to True
38609>>>                WebSet pbRender of ojugadorNacionalidad to True
38610>>>                WebSet pbRender of oligaNombre   to True
38611>>>                WebSet pbRender of oligaPais     to True
38612>>>                WebSet pbRender of oequipoNombre to True
38613>>>                
38613>>>                WebSet pbRender of oDetailButton to False
38614>>>                
38614>>>                Send Rebuild_Constraints of ojugador_DD
38615>>>                Case Break
38616>>>        Case End
38616>>>
38616>>>        // OBLIGATORIO: Fuerza a la lista a redibujar las columnas en el navegador
38616>>>        Send RefreshListFromDD of oList
38617>>>        End_Procedure
38618>>>
38618>>>       /* Case Begin            Case (NavigateData.eNavigateType = nfFromParent)                // If from parent, this is a constrained drill down                Case Break            Case (NavigateData.eNavigateType = nfFromChild)                // If from child, this is a probably a parent lookup from a Zoom                Case Break            Case (NavigateData.eNavigateType = nfFromMain)                // If from main, this is a probably a main-file lookup from a Zoom                WebSet pbRender of oDetailButton to False                Case Break            Case Else // must be nfUndefined                // This may be the start of a drilldown query or this may be used for some kind of custom query.        Case End    End_Procedure*/
38618>>>
38618>>>
38618>>>End_Object 
