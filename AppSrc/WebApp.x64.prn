38640>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38643>>>        WebSet pbRender of oNewButton to True
38644>>>        WebSet pbRender of oDetailButton to True
38645>>>        
38645>>>        Case Begin
38645>>>            // --- MODALIDAD 1: SI ENTRAS DESDE EQUIPO (Solo Datos Esenciales) ---
38645>>>            Case (NavigateData.eNavigateType = nfFromParent)
38647>>>                WebSet psCaption to "Jugadores del Equipo"
38648>>>                
38648>>>                // OCULTAMOS las columnas que no queremos ver desde Equipo
38648>>>                WebSet pbRender of oligaNombre   to False
38649>>>                WebSet pbRender of oligaPais     to False
38650>>>                WebSet pbRender of oequipoNombre to False
38651>>>                
38651>>>                // MOSTRAMOS solo Nombre, Apellido y Nacionalidad
38651>>>                WebSet pbRender of ojugadorNombre to True
38652>>>                WebSet pbRender of ojugadorApellido to True
38653>>>                WebSet pbRender of ojugadorNacionalidad to True
38654>>>
38654>>>                // Sincronización limpia de la base de datos por ID
