39244>>>    Procedure SetActionButtons
39247>>>        tWebNavigateData NavigateData
39247>>>        tWebNavigateData NavigateData
39247>>>        Boolean bHasRecord
39247>>>        Handle hoDD
39247>>>
39247>>>        Get Server to hoDD
39248>>>        Get GetNavigateData to NavigateData
39249>>>        Get HasRecord of hoDD to bHasRecord
39250>>>
39250>>>        // let's hide all buttons and then Show the ones we want
39250>>>        WebSet pbRender of oEditBtn to False
39251>>>        WebSet pbRender of oSaveBtn to False
39252>>>        WebSet pbRender of oCancelChangesBtn to False
39253>>>        WebSet pbRender of oDeleteBtn to False
39254>>>
39254>>>        If (NavigateData.bReadOnly) Begin
39256>>>            WebSet pbRender of oEditBtn to True
39257>>>        End
39257>>>>
39257>>>        Else Begin
39258>>>            WebSet pbRender of oSaveBtn to True
39259>>>            WebSet pbRender of oCancelChangesBtn to True
39260>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39261>>>        End
39261>>>>
39261>>>    End_Procedure
