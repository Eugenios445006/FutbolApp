39272>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39275>>>        Case Begin
39275>>>            Case (NavigateData.eNavigateType = nfFromMain)
39277>>>                // If from main, this is a propbably a main file Select to Zoom.
39277>>>                Case Break
39278>>>
39278>>>            Case (NavigateData.eNavigateType = nfFromParent)
39281>>>                // If from parent, this is a constrained drill down.
39281>>>                Case Break
39282>>>
39282>>>            Case (NavigateData.eNavigateType = nfFromChild)
39285>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39285>>>                Case Break
39286>>>
39286>>>            Case Else // must be nfUndefined
39286>>>
39286>>>        Case End
39286>>>
39286>>>        Send SetActionButtons
