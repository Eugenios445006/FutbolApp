37648>>>>>>>
37648>>>>>>>        Case Begin
37648>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37650>>>>>>>                // If from parent, this is a constrained drill down
37650>>>>>>>                Case Break
37651>>>>>>>
37651>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37654>>>>>>>                // If from child, this is a probably a parent lookup from a Zoom
37654>>>>>>>                Case Break
37655>>>>>>>
37655>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37658>>>>>>>                // If from main, this is a probably a main-file lookup from a Zoom
37658>>>>>>>                WebSet pbRender of oDetailButton to False
37659>>>>>>>                Case Break
37660>>>>>>>
37660>>>>>>>            Case Else // must be nfUndefined
37660>>>>>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37660>>>>>>>
37660>>>>>>>        Case End
37660>>>>>>>
37660>>>>>>>    End_Procedure
