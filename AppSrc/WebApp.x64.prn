39301>>>    Procedure SetActionButtons
39304>>>        tWebNavigateData NavigateData
39304>>>        tWebNavigateData NavigateData
39304>>>        Boolean bHasRecord
39304>>>        Handle hoDD
39304>>>
39304>>>        Get Server to hoDD
39305>>>        Get GetNavigateData to NavigateData
39306>>>        Get HasRecord of hoDD to bHasRecord
39307>>>
39307>>>        WebSet pbRender of oEditBtn to False
39308>>>        WebSet pbRender of oSaveBtn to False
39309>>>        WebSet pbRender of oCancelChangesBtn to False
39310>>>        WebSet pbRender of oDeleteBtn to False
39311>>>
39311>>>        If (NavigateData.bReadOnly) Begin
39313>>>            WebSet pbRender of oEditBtn to True
39314>>>        End
39314>>>>
39314>>>        Else Begin
39315>>>            WebSet pbRender of oSaveBtn to True
39316>>>            WebSet pbRender of oCancelChangesBtn to True
39317>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39318>>>        End
39318>>>>
39318>>>    End_Procedure
